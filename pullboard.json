{
  "gate": "uv run --no-project --with pytest python -m pytest -q",
  "spec": "SPEC.md",
  "practice": "DOCTRINE.md",
  "worktrees": "inside",
  "verify": {
    "policy": "any",
    "family": "off"
  },
  "agents": {
    "names": "suffix"
  },
  "lease": "2h",
  "lanes": {
    "review": {
      "owns": [],
      "starts": "any time: verifiers check submitted work and own no folders"
    },
    "core": {
      "owns": [
        "never_leaves/",
        "tests/"
      ]
    },
    "docs": {
      "owns": [
        "docs/",
        "README.md"
      ]
    }
  },
  "shared": [],
  "commits": {
    "requireIds": [
      "feat",
      "fix"
    ]
  },
  "checks": {
    "provesNothing": "hold"
  }
}
